{
  "name": "wage-calc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node scripts/prisma-generate.mjs sqlite && vitest run",
    "test:watch": "node scripts/prisma-generate.mjs sqlite && vitest",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/prisma-generate.mjs && tsx prisma/seed.ts",
    "schema:prod": "node scripts/gen-production-schema.mjs",
    "migrate:prod": "node scripts/prisma-generate.mjs && prisma migrate deploy",
    "db:export": "node scripts/prisma-generate.mjs && tsx scripts/export-data.ts",
    "db:import": "node scripts/prisma-generate.mjs && tsx scripts/import-data.ts",
    "setup:neon": "node scripts/setup-neon.mjs",
    "gen:secret": "node scripts/gen-secret.mjs",
    "verify:db": "node scripts/prisma-generate.mjs && tsx scripts/verify-db.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.5.1",
    "bcryptjs": "^3.0.3",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.8",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
